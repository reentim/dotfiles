#!/usr/bin/env bash

set -euo pipefail

current_scale=$(hyprctl -j monitors | jq '.[0]["scale"]')

main() {
	new_scale="$(fzf_scale)"
	hyprctl keyword monitor ,3840x2160@240.00Hz,auto,${new_scale}
}

fzf_scale() {
	cat <<-EOF | fzf | cut -d ' ' -f2-
	a) 1.00
	b) 1.25
	c) 1.50
	d) 1.67
	e) 2.00
	EOF
}

main

