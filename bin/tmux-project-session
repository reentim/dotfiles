#!/usr/bin/env bash

set -euo pipefail

projects="${HOME}/proj/"

main() {
  find_cmd=$(command -v gfind || command -v find)
  proj_path="${projects}$(
    set +o pipefail
    # a project dir is a non-hidden dir that don't start with underscore,
    # sorted by modified time.
    "${find_cmd}" "${projects}" -mindepth 1 \
      \( -name ".*" -type d -prune \) -o \
      \( -type d ! -name "_*" \
          \( -path "*/proj/*" ! -path "*/proj/*/*" -o -path "*/_*/*" \) \
          -prune -printf '%T@\t%P\n' \) \
      | sort -nr \
      | cut -f2- \
      | fzf --exact --print-query --height=100% --prompt="^g for github> " \
          --bind 'ctrl-g:become(echo "github")' \
      | tail -n 1
  )"

  proj_name="$(basename ${proj_path})"

  if [[ $proj_name = "github" ]]; then
    name_with_owner="$(gh repo list --json 'nameWithOwner' \
      | jq -r '.[] | .[]' \
      | fzf --exact --print-query --height=100% \
      | tail -n 1
    )"
    proj_name="$(basename ${name_with_owner})"
    proj_path="${projects}${proj_name}"
    gh repo clone "${name_with_owner}" "${proj_path}"
  fi

  if [[ ! -d $proj_path ]]; then
    read -n 1 -p "Create ${proj_path}? [Y/n] " confirmed
    [[ $confirmed == [Nn] ]] && exit
    mkdir -p "${proj_path}"
  fi

  if [[ $proj_path == $projects ]]; then
    # no project has been selected
    exit
  fi

  cd "${proj_path}"

  session_name=$(normalised_session_name "${proj_name}")

  if ! tmux has-session -t "${session_name}" >/dev/null 2>&1; then
    tmux new-session -d -s "${session_name}"
    set_up_session
  fi

  if [[ $TMUX ]]; then
    tmux switch-client -t "${session_name}"
  else
    tmux new-session -As "${session_name}"
    set_up_session
  fi
}

set_up_session() {
  if command -v "tmux-session-${proj_name}" >/dev/null 2>&1; then
    "tmux-session-${proj_name}"
  elif pnpm run | grep -w dev; then
    echo 'here' >>/tmp/log
    tmux send-keys -t "${session}" "pnpm run dev" C-m
    tmux new-window
    tmux send-keys -t "${session}" "$EDITOR" C-m
  fi
}

normalised_session_name() {
  echo "${1}" | sed 's/\./_/g'
}

main
