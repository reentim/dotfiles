/* ~/Library/KeyBindings/DefaultKeyBinding.dict */
{
    "~f" = "moveWordForward:";
    "~b" = "moveWordBackward:";
    "~d" = "deleteWordForward:";
/*  "^w" = "deleteWordBackward:"; hazardous for muscle memory; RIP my desktop linux browser tabs */
    "~u" = (selectParagraph:, delete:, moveToBeginningOfParagraph:);

}
